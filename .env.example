# Copy this file to `.env` and fill in your own key.
# .env is already excluded via .gitignore — never commit real keys.

# OpenCode Zen (OpenAI-compatible, free-tier models available):
OPENAI_BASE_URL=https://opencode.ai/zen/v1
OPENAI_API_KEY=your_key_here
# Verified free model. Alternatives ending in -free also work,
# e.g. nemotron-3.5-lightning-free, mimo-v2.5-free
MODEL_ID=nemotron-3-ultra-free
